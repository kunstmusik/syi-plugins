              <objectName />
              <x>10</x>
              <y>10</y>
              <groupName>LFO</groupName>
              <titleEnabled>true</titleEnabled>
              <width>230</width>
              <height>142</height>
              <backgroundColor>0x00000033</backgroundColor>
              <borderColor>0x000000ff</borderColor>
              <labelTextColor>0xffffffff</labelTextColor>
              <font>
                <name>Roboto</name>
                <size>12.0</size>
                <style>0</style>
              </font>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBVSlider" version="2" uniqueId="w-a5f4da31-91af-4881-9788-d4eb7a2e0f68">
                <objectName>lfo_rate</objectName>
                <x>10</x>
                <y>30</y>
                <automationAllowed>true</automationAllowed>
                <minimum>0</minimum>
                <maximum>10</maximum>
                <value>3</value>
                <bdresolution>0.1</bdresolution>
                <randomizable>true</randomizable>
                <valueDisplayEnabled>true</valueDisplayEnabled>
                <sliderHeight>150</sliderHeight>
              </bsbObject>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBLabel" version="2" uniqueId="w-8062a6e3-9d7d-464e-a435-a14848b37ad1">
                <objectName />
                <x>22</x>
                <y>10</y>
                <label>RATE</label>
                <font>
                  <name>Roboto</name>
                  <size>12.0</size>
                  <style>0</style>
                </font>
              </bsbObject>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBVSlider" version="2" uniqueId="w-ed47e337-bf4d-41c2-b065-d4afbd3c7fac">
                <objectName>lfo_delay_time</objectName>
                <x>70</x>
                <y>30</y>
                <automationAllowed>true</automationAllowed>
                <minimum>0</minimum>
                <maximum>10</maximum>
                <value>8</value>
                <bdresolution>0.1</bdresolution>
                <randomizable>true</randomizable>
                <valueDisplayEnabled>true</valueDisplayEnabled>
                <sliderHeight>150</sliderHeight>
              </bsbObject>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBLabel" version="2" uniqueId="w-e9adf546-2c85-460a-abcb-e96648e2ece6">
                <objectName />
                <x>76</x>
                <y>10</y>
                <label>DELAY</label>
                <font>
                  <name>Roboto</name>
                  <size>12.0</size>
                  <style>0</style>
                </font>
              </bsbObject>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBDropdown" version="2" uniqueId="w-f10abf27-f086-4921-b0ee-4d34fa9cffaa">
                <objectName>lfo_trigger_mode</objectName>
                <x>130</x>
                <y>90</y>
                <automationAllowed>true</automationAllowed>
                <selectedIndex>1</selectedIndex>
                <fontSize>12</fontSize>
                <randomizable>false</randomizable>
                <bsbDropdownItemList>
                  <bsbDropdownItem uniqueId="-1700000022">
                    <name>AUTO</name>
                    <value>0</value>
                  </bsbDropdownItem>
                  <bsbDropdownItem uniqueId="-1700000023">
                    <name>MANUAL</name>
                    <value>1</value>
                  </bsbDropdownItem>
                </bsbDropdownItemList>
              </bsbObject>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBCheckBox" uniqueId="w-47cf52a2-aa42-43bb-8b17-8b9484141cfb">
                <objectName>lfo_trig</objectName>
                <x>130</x>
                <y>122</y>
                <automationAllowed>true</automationAllowed>
                <label>LFO TRIG</label>
                <selected>false</selected>
                <randomizable>false</randomizable>
              </bsbObject>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBLabel" version="2" uniqueId="w-143f7555-a4a6-4105-93ac-78405369c41d">
                <objectName />
                <x>130</x>
                <y>70</y>
                <label>TRIGGER MODE</label>
                <font>
                  <name>Roboto</name>
                  <size>12.0</size>
