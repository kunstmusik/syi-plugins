                <label>DELAY</label>
                <font>
                  <name>Roboto</name>
                  <size>12.0</size>
                  <style>0</style>
                </font>
              </bsbObject>
            </bsbObject>
            <bsbObject type="blue.orchestra.blueSynthBuilder.BSBGroup" uniqueId="w-54a04a58-b677-41e0-9332-5dfb1d8d381d">
              <objectName />
              <x>10</x>
              <y>195</y>
              <groupName>TRIGGER MODE</groupName>
              <titleEnabled>true</titleEnabled>
              <width>250</width>
              <height>60</height>
              <backgroundColor>0x00000033</backgroundColor>
              <borderColor>0x000000ff</borderColor>
              <labelTextColor>0xffffffff</labelTextColor>
              <font>
                <name>Roboto</name>
                <size>12.0</size>
                <style>0</style>
              </font>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBDropdown" version="2" uniqueId="w-289c9dc1-9bca-4fa5-8482-a31be79dca1f">
                <objectName>lfo_trigger_mode</objectName>
                <x>10</x>
                <y>14</y>
                <automationAllowed>true</automationAllowed>
                <selectedIndex>0</selectedIndex>
                <fontSize>12</fontSize>
                <randomizable>false</randomizable>
                <bsbDropdownItemList>
                  <bsbDropdownItem uniqueId="-1700000016">
                    <name>AUTO</name>
                    <value>0</value>
                  </bsbDropdownItem>
                  <bsbDropdownItem uniqueId="-1700000017">
                    <name>MANUAL</name>
                    <value>1</value>
                  </bsbDropdownItem>
