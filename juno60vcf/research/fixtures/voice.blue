              </bsbObject>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBLabel" version="2" uniqueId="w-9ab7a752-ea06-4fda-ac69-9bf6fb5de095">
                <objectName />
                <x>76</x>
