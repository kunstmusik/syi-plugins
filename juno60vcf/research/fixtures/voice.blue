                </font>
              </bsbObject>
              <bsbObject type="blue.orchestra.blueSynthBuilder.BSBVSlider" version="2" uniqueId="w-d65554ec-cafd-4bb2-a413-05b4f83271dc">
                <objectName>lfo_delay_time</objectName>
                <x>70</x>
